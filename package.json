{
  "name": "home",
  "version": "1.0.0",
  "scripts": {
    "cy": "cypress open",
    "cy:run": "cypress run",
    "cy:run-all": "start-server-and-test 'npm run build:articles && ng serve --host 127.0.0.1' http-get://127.0.0.1:4200 cy:run",
    "ng": "ng",
    "start": "npm run build:articles && ng serve",
    "build": "npm run build:articles && ng build",
    "test:ci": "jest",
    "test": "jest --watch",
    "lint": "ng lint",
    "pre-deploy": "npm run snyk:test && ng lint && npm run stylelint && npm run test:ci && npm run cy:run-all",
    "prepare": "husky",
    "snyk:monitor": "snyk monitor",
    "snyk:test": "snyk test",
    "stylelint": "stylelint 'src/**/*.scss'",
    "prerender": "npm run build:articles && ng build --configuration production",
    "build:articles": "node build-articles.mts",
    "watch:articles": "node build-articles.mts --watch"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.3",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@sentry/angular": "^11.8.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/prismjs": "^1.26.6",
    "angular-eslint": "^22.6.0",
    "cypress": "^16.2.0",
    "emoji-toolkit": "^11.0.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "jsdom": "^26.1.0",
    "marked": "^18.1.1",
    "prismjs": "^1.30.0",
    "snyk": "^1.1308.1",
    "start-server-and-test": "^3.0.13",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-scss": "^7.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "allowScripts": {
    "cypress": true,
    "snyk": true,
    "esbuild": true,
    "@parcel/watcher": false,
    "lmdb": false,
    "msgpackr-extract": false,
    "unrs-resolver": false
  }
}
